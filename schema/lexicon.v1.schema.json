{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bmeunier1974/lexiqr/v1.1.0/schema/lexicon.v1.schema.json",
  "title": "lexiqr lexicon v1",
  "description": "A tenant's multilingual mapping from company jargon to canonical entities.",
  "type": "object",
  "required": ["schemaVersion", "defaultLocale", "entities"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "Optional pointer to this schema, so editors offer completion and inline validation.",
      "type": "string"
    },
    "schemaVersion": {
      "description": "The lexicon file format version this document declares.",
      "const": "1"
    },
    "defaultLocale": {
      "description": "BCP 47 tag used when resolution finds no better locale match.",
      "$ref": "#/$defs/locale"
    },
    "entities": {
      "description": "Entities keyed by canonical ID (e.g. \"product\").",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/canonicalId" },
      "additionalProperties": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?$"
    },
    "canonicalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "entity": {
      "type": "object",
      "required": ["locales"],
      "additionalProperties": false,
      "properties": {
        "canonicalId": {
          "description": "The entity this entry resolves to; defaults to the entry's own key. Several entries may name the same entity.",
          "$ref": "#/$defs/canonicalId"
        },
        "metadata": {
          "description": "Tenant-defined key/value pairs carried verbatim onto every match this entry produces. lexiqr never interprets them.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "additionalProperties": { "$ref": "#/$defs/metadataValue" }
        },
        "locales": {
          "description": "Surface forms per locale.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/locale" },
          "additionalProperties": { "$ref": "#/$defs/surfaceForms" }
        }
      }
    },
    "surfaceForms": {
      "type": "object",
      "required": ["preferred"],
      "additionalProperties": false,
      "properties": {
        "preferred": {
          "description": "The surface form the tenant considers canonical in this locale.",
          "type": "object",
          "required": ["singular"],
          "additionalProperties": false,
          "properties": {
            "singular": { "$ref": "#/$defs/surfaceForm" },
            "plural": { "$ref": "#/$defs/surfaceForm" }
          }
        },
        "alternates": {
          "description": "Other labels users type for this entity in this locale.",
          "type": "array",
          "items": { "$ref": "#/$defs/surfaceForm" },
          "uniqueItems": true
        }
      }
    },
    "surfaceForm": {
      "type": "string",
      "minLength": 1
    },
    "metadataValue": {
      "description": "A scalar, or a set of scalars. No null — an absent key already means absent — and no nesting, which would invite a query language lexiqr deliberately does not have.",
      "oneOf": [
        { "$ref": "#/$defs/metadataScalar" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/metadataScalar" }
        }
      ]
    },
    "metadataScalar": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
